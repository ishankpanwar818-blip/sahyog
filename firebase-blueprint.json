{
  "entities": {
    "Team": {
      "title": "Team",
      "description": "Tactical rescue and exercise squad unit",
      "type": "object",
      "properties": {
        "teamId": { "type": "string", "description": "Unique squad party identifier" },
        "teamName": { "type": "string", "description": "Mission title or squad name" },
        "missionObjective": { "type": "string", "description": "Tactical mission brief" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "simulationMode": { "type": "boolean" }
      },
      "required": ["teamId", "teamName", "createdAt", "createdBy"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Individual responder or simulated tactical squad operative",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "teamId": { "type": "string" },
        "displayName": { "type": "string" },
        "callsign": { "type": "string" },
        "role": { "type": "string" },
        "simulatedLatitude": { "type": "number" },
        "simulatedLongitude": { "type": "number" },
        "simulatedBattery": { "type": "number" },
        "condition": { "type": "string", "enum": ["safe", "caution", "emergency"] },
        "note": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "teamId", "displayName", "condition", "simulatedLatitude", "simulatedLongitude"]
    },
    "MedicalAlert": {
      "title": "MedicalAlert",
      "description": "Medical distress emergency beacon event",
      "type": "object",
      "properties": {
        "alertId": { "type": "string" },
        "teamId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "callsign": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string", "enum": ["normal", "caution", "emergency"] },
        "message": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "acknowledgedAt": { "type": "string", "format": "date-time" },
        "acknowledgedBy": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "resolvedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "acknowledged", "resolved"] }
      },
      "required": ["alertId", "teamId", "memberId", "status", "createdAt"]
    },
    "TeamMessage": {
      "title": "TeamMessage",
      "description": "Tactical squad radio comms communication record",
      "type": "object",
      "properties": {
        "messageId": { "type": "string" },
        "teamId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderCallsign": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isEmergency": { "type": "boolean" },
        "deliveryState": { "type": "string", "enum": ["pending", "delivered", "failed"] }
      },
      "required": ["messageId", "teamId", "senderId", "content", "createdAt"]
    },
    "Checkpoint": {
      "title": "Checkpoint",
      "description": "Designated tactical assembly or evacuation point",
      "type": "object",
      "properties": {
        "checkpointId": { "type": "string" },
        "teamId": { "type": "string" },
        "name": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["checkpointId", "teamId", "name", "latitude", "longitude"]
    },
    "ActivityEvent": {
      "title": "ActivityEvent",
      "description": "Audit and operational activity timeline event",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "teamId": { "type": "string" },
        "actorId": { "type": "string" },
        "actor": { "type": "string" },
        "eventType": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["normal", "caution", "emergency"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "teamId", "eventType", "createdAt"]
    }
  },
  "firestore": {
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Root team documents"
    },
    "/teams/{teamId}/members/{memberId}": {
      "schema": "TeamMember",
      "description": "Team squad members and live positions"
    },
    "/teams/{teamId}/alerts/{alertId}": {
      "schema": "MedicalAlert",
      "description": "Emergency alerts and casualty beacons"
    },
    "/teams/{teamId}/messages/{messageId}": {
      "schema": "TeamMessage",
      "description": "Radio messages and squad chat"
    },
    "/teams/{teamId}/checkpoints/{checkpointId}": {
      "schema": "Checkpoint",
      "description": "Assembly and evacuation checkpoints"
    },
    "/teams/{teamId}/activityEvents/{eventId}": {
      "schema": "ActivityEvent",
      "description": "Activity timeline events"
    }
  }
}
