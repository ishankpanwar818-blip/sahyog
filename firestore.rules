rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTeamMember(teamId) {
      return isAuthenticated();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Teams root collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      // Squad Members subcollection
      match /members/{memberId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if true;
      }

      // Emergency alerts subcollection
      match /alerts/{alertId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // Squad messages subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      // Checkpoints subcollection
      match /checkpoints/{checkpointId} {
        allow read: if true;
        allow create, update, delete: if true;
      }

      // Activity timeline events subcollection
      match /activityEvents/{eventId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }
  }
}
